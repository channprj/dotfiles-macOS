export DEV_COMPOSE_FILE="./docker-compose.dev.yml"

_dc_dev() {
  : "${DEV_COMPOSE_FILE:?Set DEV_COMPOSE_FILE to your dev compose file path.}"
  command docker compose -f "$DEV_COMPOSE_FILE" "$@"
}

# 실행 함수
dc-up-dev()   { _dc_dev up   "$@"; }
dc-down-dev() { _dc_dev down "$@"; }
dc-logs-dev() { _dc_dev logs "$@"; }

# --- 아래는 '완성용 프록시 함수' (이름 규칙: _<명령어>) ---
# dc-up-dev에서 탭을 누르면, 실제론 "docker compose up ..." 문맥으로 _docker 호출
_dc_up_dev_completion() {
  local -a save_words; save_words=("${words[@]}")
  local save_curcontext="$curcontext"

  # words를 'docker compose up ...' 구조로 바꿔서 _docker에게 전달
  words=( docker compose up "${words[@]:2}" )
  CURRENT=$#words
  _docker

  # 원상복구 (안전)
  words=("${save_words[@]}")
  curcontext="$save_curcontext"
}

_dc_down_dev_completion() {
  local -a save_words; save_words=("${words[@]}")
  local save_curcontext="$curcontext"
  words=( docker compose down "${words[@]:2}" )
  CURRENT=$#words
  _docker
  words=("${save_words[@]}")
  curcontext="$save_curcontext"
}

_dc_logs_dev_completion() {
  local -a save_words; save_words=("${words[@]}")
  local save_curcontext="$curcontext"
  words=( docker compose logs "${words[@]:2}" )
  CURRENT=$#words
  _docker
  words=("${save_words[@]}")
  curcontext="$save_curcontext"
}

# compdef는 .zshrc에서 해도 되지만, 여기서 바로 매핑해도 됩니다:
# (단, _docker가 로드된 이후여야 함. 위 .zshrc 순서를 지키면 OK)
if (( $+functions[compdef] )); then
  compdef _dc_up_dev_completion dc-up-dev
  compdef _dc_down_dev_completion dc-down-dev
  compdef _dc_logs_dev_completion dc-logs-dev
fi

# Django management command wrapper with caching
dj() {
    docker compose exec api uv run ./manage.py "$@"
}

if [ -n "$ZSH_VERSION" ]; then
    _dj_completion() {
        local -a commands
        local state cache_key cache_file modified_at=0

        if (( $+commands[md5] )); then
            cache_key="$(print -rn -- "$PWD" | md5)"
        elif (( $+commands[md5sum] )); then
            cache_key="$(print -rn -- "$PWD" | md5sum | cut -d' ' -f1)"
        else
            cache_key="$(print -rn -- "$PWD" | cksum | cut -d' ' -f1)"
        fi
        cache_file="${TMPDIR:-/tmp}/.dj_commands_cache_${cache_key}"

        _arguments '1: :->command' '*::arg:->args'

        case $state in
            command)
                # 캐시 파일이 없거나 1시간 이상 지났으면 갱신
                if [[ -f "$cache_file" ]]; then
                    modified_at="$(stat -f %m "$cache_file" 2>/dev/null || stat -c %Y "$cache_file" 2>/dev/null || print 0)"
                fi
                if [[ ! -f "$cache_file" ]] || (( $(date +%s) - modified_at > 3600 )); then
                    if [ -f "docker-compose.yml" ] || [ -f "compose.yml" ]; then
                        docker compose exec -T api uv run ./manage.py help --commands 2>/dev/null | grep -v '^\[' | sort > "$cache_file"
                    fi
                fi

                if [ -f "$cache_file" ]; then
                    commands=(${(f)"$(<"$cache_file")"})
                    _describe 'django commands' commands
                fi
                ;;
            args)
                case $words[1] in
                    test)
                        _files -W apps -/
                        ;;
                    migrate|makemigrations|showmigrations)
                        local apps
                        apps=(${(f)"$(find apps -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null)"})
                        _describe 'django apps' apps
                        ;;
                esac
                ;;
        esac
    }

    (( $+functions[compdef] )) && compdef _dj_completion dj
fi

# 캐시 수동 갱신 함수 (명령어 추가 후):
dj-refresh() {
    command rm -f -- "${TMPDIR:-/tmp}"/.dj_commands_cache_*(N)
    echo "Django commands cache cleared"
}
