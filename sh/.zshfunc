# macOS permissions
reset-iterm2-permissions() {
  tccutil reset SystemPolicyRemovableVolumes com.googlecode.iterm2
  tccutil reset SystemPolicyAllFiles com.googlecode.iterm2
}

# Stop and delete the Herdr session named after the invoking directory.
_hsa_delete() {
  emulate -L zsh
  setopt localoptions pipefail

  local invocation_cwd="$PWD"
  local session_name="${invocation_cwd:t}"
  local sessions_json=""
  local session_state=""
  local reply=""
  local arg
  local force=0

  [[ -n "$session_name" ]] || session_name="root"

  for arg in "$@"; do
    case "$arg" in
      -f | --force)
        force=1
        ;;
      *)
        print -u2 "hsa: unknown delete option: $arg"
        print -u2 "usage: hsa delete [-f|--force]"
        return 2
        ;;
    esac
  done

  if (( ! $+commands[herdr] && ! $+functions[herdr] )); then
    print -u2 "hsa: herdr is not installed or not in PATH"
    return 127
  fi
  if (( ! $+commands[jq] )); then
    print -u2 "hsa: jq is required to inspect Herdr sessions"
    return 127
  fi

  if ! sessions_json="$(herdr session list --json 2>/dev/null)"; then
    print -u2 "hsa: could not list Herdr sessions"
    return 1
  fi
  if ! session_state="$(
    print -r -- "$sessions_json" |
      jq -er --arg name "$session_name" '
        (if type == "array" then .
         elif type == "object" and (.sessions | type) == "array" then .sessions
         else error("invalid Herdr session list")
         end) as $sessions
        | [$sessions[] | select(.name == $name)]
        | if length == 0 then "missing"
          elif .[0].running == true then "running"
          else "stopped"
          end
      ' 2>/dev/null
  )"; then
    print -u2 "hsa: Herdr returned an invalid session list"
    return 1
  fi

  if [[ "$session_state" == "missing" ]]; then
    print "hsa: Herdr session '$session_name' does not exist"
    return 0
  fi

  if (( ! force )); then
    if [[ ! -t 0 ]]; then
      print -u2 "hsa: confirmation requires a terminal; use --force for non-interactive deletion"
      return 1
    fi

    print -n -- "Stop and delete Herdr session '$session_name'? [y/N] "
    IFS= read -r reply || reply=""
    if [[ "$reply" != [yY] ]]; then
      print "hsa: deletion cancelled"
      return 0
    fi
  fi

  if [[ "$session_state" == "running" ]]; then
    if ! herdr session stop "$session_name" >/dev/null; then
      print -u2 "hsa: could not stop Herdr session '$session_name'"
      return 1
    fi
  fi

  if ! herdr session delete "$session_name" >/dev/null; then
    print -u2 "hsa: could not delete Herdr session '$session_name'"
    return 1
  fi

  print "hsa: stopped and deleted Herdr session '$session_name'"
}

# Attach a named Herdr session and make the invoking directory its active workspace.
hsa() {
  emulate -L zsh
  setopt localoptions pipefail

  if (( $# > 0 )); then
    case "$1" in
      delete)
        shift
        _hsa_delete "$@"
        return $?
        ;;
      *)
        print -u2 "hsa: unknown command: $1"
        print -u2 "usage: hsa [delete [-f|--force]]"
        return 2
        ;;
    esac
  fi

  local invocation_cwd="$PWD"
  local canonical_cwd="${invocation_cwd:A}"
  local session_name="${invocation_cwd:t}"
  local server_status=""
  local snapshot=""
  local pane_rows=""
  local workspace_id=""
  local pane_cwd=""
  local pane_workspace_id=""
  local bootstrap_pid=""
  local server_ready=0
  local attempt

  # `${PWD:t}` is empty at the filesystem root, but Herdr requires a name.
  [[ -n "$session_name" ]] || session_name="root"

  if (( ! $+commands[herdr] && ! $+functions[herdr] )); then
    print -u2 "hsa: herdr is not installed or not in PATH"
    return 127
  fi
  if (( ! $+commands[jq] )); then
    print -u2 "hsa: jq is required to inspect the Herdr session"
    return 127
  fi

  server_status="$(herdr --session "$session_name" status server 2>/dev/null)"
  if [[ "$server_status" != *"status: running"* ]]; then
    # Starting an attach without a terminal launches Herdr's detached server.
    # The temporary client is stopped after the API socket becomes available.
    herdr session attach "$session_name" </dev/null >/dev/null 2>&1 &
    bootstrap_pid=$!

    for attempt in {1..100}; do
      server_status="$(herdr --session "$session_name" status server 2>/dev/null)"
      if [[ "$server_status" == *"status: running"* ]]; then
        server_ready=1
        break
      fi
      sleep 0.05
    done

    if kill -0 "$bootstrap_pid" 2>/dev/null; then
      kill "$bootstrap_pid" 2>/dev/null || true
    fi
    wait "$bootstrap_pid" 2>/dev/null || true

    if (( ! server_ready )); then
      print -u2 "hsa: Herdr session '$session_name' did not start"
      return 1
    fi
  fi

  if ! snapshot="$(herdr --session "$session_name" api snapshot 2>/dev/null)"; then
    print -u2 "hsa: could not inspect Herdr session '$session_name'"
    return 1
  fi
  if ! pane_rows="$(
    print -r -- "$snapshot" |
      jq -r '.result.snapshot.panes[]? | select(.cwd != null and .workspace_id != null) | [.cwd, .workspace_id] | @tsv' 2>/dev/null
  )"; then
    print -u2 "hsa: Herdr returned an invalid session snapshot"
    return 1
  fi

  while IFS=$'\t' read -r pane_cwd pane_workspace_id; do
    if [[ -n "$pane_cwd" && "${pane_cwd:A}" == "$canonical_cwd" ]]; then
      workspace_id="$pane_workspace_id"
      break
    fi
  done <<<"$pane_rows"

  if [[ -n "$workspace_id" ]]; then
    if ! herdr --session "$session_name" workspace focus "$workspace_id" >/dev/null; then
      print -u2 "hsa: could not focus '$invocation_cwd' in session '$session_name'"
      return 1
    fi
  else
    if ! herdr --session "$session_name" workspace create --cwd "$invocation_cwd" --focus >/dev/null; then
      print -u2 "hsa: could not create a workspace for '$invocation_cwd'"
      return 1
    fi
  fi

  herdr session attach "$session_name"
}
